## Customization
VITE_LOGO_PATH='/logos/logo.svg'
VITE_NAME=CloudNet

## Self-hosted domain name
VITE_DOMAIN=http://localhost:3000

## Cloudnet server address
VITE_CLOUDNET_ADDRESS=
## Hide the Cloudnet server address from input fields
VITE_CLOUDNET_ADDRESS_HIDDEN=false

## Reject loopback/private addresses on sign in (SSRF protection for public instances)
BLOCK_PRIVATE_ADDRESSES=false

# Use Sentry
## Error reporting for both the server and the browser. Leave empty to keep it off.
VITE_SENTRY_DSN=
## Only needed to upload source maps at build time.
SENTRY_URL=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_SPOTLIGHT=false

# Appearance
## Defaults for everyone; people can still pick their own. Values are listed in the README.
## Quote a hex accent, an unquoted # starts a comment: THEME_ACCENT="#3b82f6"
THEME_PALETTE=
THEME_ACCENT=
THEME_RADIUS=
THEME_STATUS_COLORS=
